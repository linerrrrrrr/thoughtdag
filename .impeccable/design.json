  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled save action; the action color keeps white text in both appearances.",
      "html": "<button class=\"ds-primary\">Save</button>",
      "css": ".ds-primary{font-family:var(--font-sans);background:var(--color-action);color:#fff;border:0;border-radius:var(--radius-control);padding:6px 16px;font-size:.875rem;line-height:1.45;cursor:pointer;transition:background-color .15s ease}.ds-primary:hover{background:var(--color-action-strong)}.ds-primary:disabled{opacity:.3;cursor:not-allowed}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-nav button:focus-visible,.ds-tag:focus-visible,.ds-file-name:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Project control",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact project navigation aligned with the session controls.",
      "html": "<button class=\"ds-secondary\">Research canvas <span aria-hidden=\"true\">⌄</span></button>",
      "css": ".ds-secondary{font-family:var(--font-sans);height:32px;display:inline-flex;align-items:center;gap:8px;padding:0 12px;background:var(--color-card);color:var(--color-ink);border:1px solid var(--color-line);border-radius:var(--radius-control);font-size:.875rem;line-height:1;font-weight:500;cursor:pointer;transition:background-color .15s ease}.ds-secondary:hover{background:var(--color-wash)}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-nav button:focus-visible,.ds-tag:focus-visible,.ds-file-name:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Follow-up composer",
