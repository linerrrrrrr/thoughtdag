      "refersTo": "composer",
      "description": "A borderless field whose padded surface carries focus.",
      "html": "<div class=\"ds-composer\"><textarea aria-label=\"Follow up\" placeholder=\"Follow up…\" rows=\"1\"></textarea></div>",
      "css": ".ds-composer{background:var(--color-wash);border-radius:var(--radius-content);padding:10px 16px}.ds-composer textarea{font-family:var(--font-sans);display:block;width:100%;background:transparent;color:var(--color-ink);border:0;font-size:1rem;line-height:1.625;resize:none;max-height:160px}.ds-composer textarea::placeholder{color:var(--color-ink-faint)}.ds-composer textarea:focus-visible{outline:none}.ds-composer:focus-within{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Embedded view switch",
